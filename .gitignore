# Add any directories, files, or patterns you don't want to be tracked by version control
*.dcu
*.bpl
*.map
*.exe
*.tvsconfig
*.txaPackage
*.local
*.identcache
*.stat

# DUnitX — saída de runner local/CI (evita poluir git status / diffs)
# Glob, e não nome exato: cada projeto grava <Projeto>-dunitx-results.xml ao lado
# do próprio EXE, e numa build pela IDE esse "ao lado do EXE" cai dentro da árvore
# (pasta do projeto ou Win32\Debug). O * inicial casa tanto o nome novo quanto o
# antigo 'dunitx-results.xml', que ainda existe em árvore de quem rodou a suíte
# antes desta mudança — e continua valendo para o projeto que alguém criar amanhã.
*dunitx-results.xml

# Docusaurus (docs-src/) — artefatos locais; build oficial no GitHub Actions
docs-src/node_modules/
docs-src/build/
docs-src/.docusaurus/

__history/
__recovery/
.local-readonly/

# Tooling and Metadata
.gemini/
.codex/
.agents/

# Test runner output files (agent pollution guard — ESP-046)
test_output*.txt
tests_output*.txt

# Scratch/throwaway Delphi programs (agent pollution guard — ESP-046)
test_*.dpr
!Test Delphi/*_tests/PTestFluentSQL*.dpr
!Test Delphi/*_tests/TestFluentSQL_*.dpr

# Boss package manager files
!boss.json
!boss-lock.json
